  "icon": "./icon.png",
  "documentationUrl": "https://github.com/Stellenbosch-Technologies/rhebok/tree/main/docs",
  "supportUrl": "https://github.com/Stellenbosch-Technologies/rhebok/issues",
  "repository": "https://github.com/Stellenbosch-Technologies/rhebok",
  "license": "AGPL-3.0-only",
  "keywords": ["search", "memory", "rag", "notes", "knowledge-base", "local-first", "mcp"],
  "mcpServers": {
    "rhebok": {
      "command": "${CLAUDE_PLUGIN_ROOT}/scripts/rhebok.sh",
      "args": [
        "mcp"
      ]
    }
